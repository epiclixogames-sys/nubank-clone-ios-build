+/// Parse Brazilian currency into integer cents without rounding errors.
+int? parsePixAmount(String input) {
+  final text = input.trim().replaceFirst(RegExp(r'^R\$\s*'), '');
+  if (!RegExp(r'^(?:\d+|\d{1,3}(?:\.\d{3})+)(?:,\d{1,2})?$')
+      .hasMatch(text)) return null;
+  final parts = text.replaceAll('.', '').split(',');
+  final reais = int.tryParse(parts[0]);
+  if (reais == null || reais > 99999999) return null;
+  final cents = reais * 100 +
+      (parts.length == 2 ? int.parse(parts[1].padRight(2, '0')) : 0);
+  return cents > 0 ? cents : null;
+}
+
+String formatPixAmount(int cents) {
+  final digits = (cents ~/ 100).toString();
+  final grouped = digits.replaceAllMapped(
+    RegExp(r'(\d)(?=(\d{3})+(?!\d))'), (match) => '${match[1]}.',
+  );
+  return 'R\$ $grouped,${(cents % 100).toString().padLeft(2, '0')}';
+}
+
+class SimulatedPix {
+  final String recipient, pixKey, institution, sender, description;
+  final int cents;
+  final DateTime createdAt;
+
+  const SimulatedPix({
+    required this.recipient,
+    required this.pixKey,
+    required this.cents,
+    required this.createdAt,
+    this.institution = '',
+    this.sender = '',
+    this.description = '',
+  });
+
+  String get reference => 'SIM-${createdAt.microsecondsSinceEpoch}';
+  String get dateLabel {
+    String two(int n) => n.toString().padLeft(2, '0');
+    return '${two(createdAt.day)}/${two(createdAt.month)}/${createdAt.year} '
+        '${two(createdAt.hour)}:${two(createdAt.minute)}';
+  }
+
+  Map<String, String> get details => {
+    'Destinatário informado': recipient,
+    'Chave informada (não verificada)': pixKey,
+    if (institution.isNotEmpty) 'Instituição informada': institution,
+    if (sender.isNotEmpty) 'Remetente informado': sender,
+    if (description.isNotEmpty) 'Descrição': description,
+  };
+
+  String asText() => [
+    'SIMULAÇÃO — SEM VALOR FINANCEIRO',
+    'Comprovante de simulação',
+    'Nenhum pagamento foi realizado.',
+    'Valor: ${formatPixAmount(cents)}',
+    ...details.entries.map((e) => '${e.key}: ${e.value}'),
+    'Gerado em: $dateLabel',
+    'Referência demonstrativa: $reference',
+    'Documento de demonstração. Não é um comprovante bancário.',
+    'SIMULAÇÃO — SEM VALOR FINANCEIRO',
+  ].join('\n');
+}
