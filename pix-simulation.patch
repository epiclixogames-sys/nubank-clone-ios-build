+import 'dart:io';
+import 'dart:ui' as ui;
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nubank_clone/pages/pix/pix_screen.dart';
+import 'package:nubank_clone/pages/pix/pix_demo_screen.dart';
+import 'package:nubank_clone/pages/pix/simulated_pix.dart';
+
+void main() {
+  test('Brazilian currency preserves cents without rounding', () {
+    expect(parsePixAmount('1.234,56'), 123456);
+    expect(parsePixAmount('R\$ 0,01'), 1);
+    expect(parsePixAmount('150,5'), 15050);
+    expect(formatPixAmount(123456), 'R\$ 1.234,56');
+    for (final value in ['', '0', '-10', '1.23', '1,999', 'NaN', '100000000']) {
+      expect(parsePixAmount(value), isNull, reason: value);
+    }
+  });
+  final sample = SimulatedPix(recipient: 'Pessoa de teste',
+    pixKey: 'exemplo@example.com', cents: 15050,
+    createdAt: DateTime(2026, 10, 28, 15, 30));
+  test('copied receipt identifies itself as simulation', () {
+    final text = sample.asText();
+    expect(text.startsWith('SIMULAÇÃO — SEM VALOR FINANCEIRO'), isTrue);
+    expect(text.endsWith('SIMULAÇÃO — SEM VALOR FINANCEIRO'), isTrue);
+    expect(text, contains('Nenhum pagamento foi realizado.'));
+    expect(sample.reference, startsWith('SIM-'));
+    expect(sample.dateLabel, '28/10/2026 15:30');
+  });
+  testWidgets('receipt image includes both simulation notices', (tester) async {
+    await tester.runAsync(() async {
+      final textFont = FontLoader('Gotham-SSm')
+        ..addFont(rootBundle.load('assets/fonts/Gotham-SSm/GothamSSm-Book.ttf'))
+        ..addFont(rootBundle.load('assets/fonts/Gotham-SSm/GothamSSm-Bold.ttf'));
+      await textFont.load();
+      final icons = FontLoader('MaterialIcons')
+        ..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'));
+      await icons.load();
+    });
+    final captureKey = GlobalKey();
+    await tester.pumpWidget(MaterialApp(theme: ThemeData(fontFamily: 'Gotham-SSm'),
+      home: Scaffold(
+      body: SingleChildScrollView(child: Align(alignment: Alignment.topLeft,
+        child: SizedBox(width: 393, child: RepaintBoundary(key: captureKey,
+          child: SimulatedPixReceipt(pix: sample))))))));
+    await tester.pumpAndSettle();
+    expect(find.text('SIMULAÇÃO — SEM VALOR FINANCEIRO'), findsNWidgets(2));
+    expect(find.text('Comprovante de simulação'), findsOneWidget);
+    expect(find.text('Nenhum pagamento foi realizado.'), findsOneWidget);
+    await tester.runAsync(() async {
+      final boundary = captureKey.currentContext!.findRenderObject() as RenderRepaintBoundary;
+      final image = await boundary.toImage(pixelRatio: 2);
+      final png = await image.toByteData(format: ui.ImageByteFormat.png);
+      expect(png, isNotNull);
+      await Directory('test-output').create(recursive: true);
+      await File('test-output/comprovante-SIMULACAO-preview.png')
+          .writeAsBytes(png!.buffer.asUint8List());
+      image.dispose();
+    });
+  });
+  testWidgets('empty form cannot advance to confirmation', (tester) async {
+    await tester.pumpWidget(const MaterialApp(home: PixScreen()));
+    await tester.tap(find.text('Transferir'));
+    await tester.pumpAndSettle();
+    final button = find.text('Revisar simulação');
+    await tester.ensureVisible(button);
+    await tester.tap(button);
+    await tester.pumpAndSettle();
+    expect(find.text('Preencha este campo'), findsNWidgets(2));
+    expect(find.text('Confirmar simulação'), findsNothing);
+  });
+  testWidgets('entered details survive review and receipt generation', (tester) async {
+    await tester.pumpWidget(const MaterialApp(home: PixScreen()));
+    await tester.tap(find.text('Transferir'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byKey(const ValueKey('pix-field-0')), 'Pessoa de teste');
+    await tester.enterText(find.byKey(const ValueKey('pix-field-1')), 'exemplo@example.com');
+    await tester.enterText(find.byKey(const ValueKey('pix-field-4')), '150,50');
+    await tester.ensureVisible(find.text('Revisar simulação'));
+    await tester.tap(find.text('Revisar simulação'));
+    await tester.pumpAndSettle();
+    expect(find.text('R\$ 150,50'), findsOneWidget);
+    await tester.ensureVisible(find.text('Confirmar simulação'));
+    await tester.tap(find.text('Confirmar simulação'));
+    await tester.pumpAndSettle();
+    expect(find.text('Usar código de teste 0000'), findsOneWidget);
+    await tester.ensureVisible(find.text('Usar código de teste 0000'));
+    await tester.tap(find.text('Usar código de teste 0000'));
+    await tester.pump(const Duration(seconds: 1));
+    await tester.pumpAndSettle();
+    expect(find.text('Sua simulação foi concluída'), findsOneWidget);
+    await tester.ensureVisible(find.text('Abrir comprovante demonstrativo'));
+    await tester.tap(find.text('Abrir comprovante demonstrativo'));
+    await tester.pumpAndSettle();
+    expect(find.text('Comprovante de simulação'), findsOneWidget);
+    expect(find.text('Pessoa de teste'), findsOneWidget);
+    expect(find.text('SIMULAÇÃO — SEM VALOR FINANCEIRO'), findsNWidgets(3));
+  });
+}
