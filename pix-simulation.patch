+import 'dart:ui' as ui;
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:nubank_clone/constants/app_colors.dart';
+import 'package:nubank_clone/pages/pix/simulated_pix.dart';
+import 'package:share_plus/share_plus.dart';
+
+class PixDemoScreen extends StatefulWidget {
+  const PixDemoScreen({super.key});
+  @override
+  State<PixDemoScreen> createState() => _PixDemoScreenState();
+}
+
+class _PixDemoScreenState extends State<PixDemoScreen> {
+  final _form = GlobalKey<FormState>();
+  final _receiptKey = GlobalKey();
+  final _fields = List.generate(6, (_) => TextEditingController());
+  int _step = -1;
+  SimulatedPix? _receipt;
+  bool _sharing = false;
+
+  @override
+  void dispose() {
+    for (final field in _fields) { field.dispose(); }
+    super.dispose();
+  }
+
+  SimulatedPix _readForm() => SimulatedPix(
+    recipient: _fields[0].text.trim(), pixKey: _fields[1].text.trim(),
+    institution: _fields[2].text.trim(), sender: _fields[3].text.trim(),
+    cents: parsePixAmount(_fields[4].text)!,
+    description: _fields[5].text.trim(), createdAt: DateTime.now(),
+  );
+
+  Future<void> _share(BuildContext buttonContext) async {
+    if (_sharing || _receipt == null) return;
+    setState(() => _sharing = true);
+    ui.Image? image;
+    try {
+      await WidgetsBinding.instance.endOfFrame;
+      if (!mounted || !buttonContext.mounted) return;
+      final boundary = _receiptKey.currentContext!.findRenderObject()
+          as RenderRepaintBoundary;
+      image = await boundary.toImage(pixelRatio: 2);
+      final data = await image.toByteData(format: ui.ImageByteFormat.png);
+      if (data == null || !buttonContext.mounted) return;
+      final box = buttonContext.findRenderObject() as RenderBox;
+      await Share.shareXFiles(
+        [XFile.fromData(data.buffer.asUint8List(), mimeType: 'image/png')],
+        fileNameOverrides: ['comprovante-SIMULACAO.png'],
+        subject: 'Comprovante de simulação — sem valor financeiro',
+        sharePositionOrigin: box.localToGlobal(Offset.zero) & box.size,
+      );
+    } catch (_) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Não foi possível gerar a imagem. Tente novamente.')),
+      );
+    } finally {
+      image?.dispose();
+      if (mounted) setState(() => _sharing = false);
+    }
+  }
+
+  Widget _button(String label, VoidCallback? onPressed) => SizedBox(
+    width: double.infinity,
+    child: ElevatedButton(
+      style: ElevatedButton.styleFrom(
+        backgroundColor: AppColors.primary, foregroundColor: Colors.white,
+        padding: const EdgeInsets.symmetric(vertical: 16),
+        shape: const StadiumBorder(),
+      ),
+      onPressed: onPressed, child: Text(label, textAlign: TextAlign.center),
+    ),
+  );
+
+  Widget _action(String label, IconData icon, {bool transfer = false}) =>
+      Expanded(child: InkWell(
+        borderRadius: BorderRadius.circular(20),
+        onTap: () {
+          if (transfer) { setState(() => _step = 0); }
+          else { ScaffoldMessenger.of(context).showSnackBar(
+            const SnackBar(content: Text('Opção ilustrativa desta demonstração.')),
+          ); }
+        },
+        child: Padding(padding: const EdgeInsets.symmetric(vertical: 16),
+          child: Column(children: [
+            CircleAvatar(radius: 36, backgroundColor: const Color(0xfff0f0f0),
+                child: Icon(icon, color: Colors.black, size: 28)),
+            const SizedBox(height: 12),
+            Text(label, textAlign: TextAlign.center,
+                style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w600)),
+          ]),
+        ),
+      ));
+
+  Widget _home() => Column(crossAxisAlignment: CrossAxisAlignment.start,
+    children: [
+      const Text('Área Pix', style: TextStyle(fontSize: 32, fontWeight: FontWeight.bold)),
+      const SizedBox(height: 20),
+      Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        _action('Transferir', Icons.payments_outlined, transfer: true),
+        _action('Pix no crédito', Icons.phone_android_outlined),
+        _action('Ler QR code', Icons.qr_code_scanner),
+      ]),
+      const SizedBox(height: 12),
+      Row(crossAxisAlignment: CrossAxisAlignment.start, children: [
+        _action('Pix Copia e Cola', Icons.copy_outlined),
+        _action('Pix Agendado', Icons.calendar_month_outlined),
+        _action('Cobrar', Icons.request_quote_outlined),
+      ]),
+      Row(children: [const Spacer(),
+        _action('Depositar', Icons.move_to_inbox_outlined), const Spacer()]),
+      const SizedBox(height: 24),
+      Container(padding: const EdgeInsets.all(20),
+        decoration: BoxDecoration(color: const Color(0xffe3dfff),
+            borderRadius: BorderRadius.circular(20)),
+        child: const Row(children: [
+          Expanded(child: Text('Explore uma transferência de teste, '
+              'sem movimentar dinheiro.', style: TextStyle(fontSize: 16))),
+          SizedBox(width: 16), Icon(Icons.science_outlined, color: AppColors.primary),
+        ]),
+      ),
+      const SizedBox(height: 28), const Divider(),
+      const Padding(padding: EdgeInsets.symmetric(vertical: 16),
+        child: Text('Preferências', style: TextStyle(fontSize: 18, color: Colors.grey))),
+    ],
+  );
+
+  Widget _entry() => Form(
+    key: _form, autovalidateMode: AutovalidateMode.onUserInteraction,
+    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      const Text('Para quem você quer\ntransferir na simulação?',
+          style: TextStyle(fontSize: 28, fontWeight: FontWeight.bold)),
+      const SizedBox(height: 8),
+      const Text('Informe os dados para uma demonstração. A chave não será '
+          'consultada e nenhum dinheiro será transferido.'),
+      const SizedBox(height: 24),
+      for (final i in [1, 0, 2, 3, 4, 5]) Padding(
+        padding: const EdgeInsets.only(bottom: 16),
+        child: TextFormField(
+          key: ValueKey('pix-field-$i'), controller: _fields[i],
+          maxLength: i == 5 ? 140 : i == 4 ? 16 : 100,
+          autocorrect: false,
+          keyboardType: i == 4
+              ? const TextInputType.numberWithOptions(decimal: true)
+              : TextInputType.text,
+          decoration: InputDecoration(
+            labelText: const ['Nome de quem receberia', 'Chave Pix',
+              'Instituição (opcional)', 'Seu nome (opcional)', 'Valor (R\$)',
+              'Descrição (opcional)'][i],
+            hintText: i == 4 ? '150,00' : null,
+            counterText: '', border: const UnderlineInputBorder(),
+            suffixIcon: i == 1 ? const Icon(Icons.qr_code, color: Colors.black) : null,
+          ),
+          validator: (value) {
+            if (i == 4 && parsePixAmount(value ?? '') == null) {
+              return 'Informe um valor positivo. Ex.: 150,00';
+            }
+            if (i < 2 && (value == null || value.trim().isEmpty)) {
+              return 'Preencha este campo';
+            }
+            return null;
+          },
