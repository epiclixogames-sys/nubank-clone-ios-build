+import 'dart:ui' as ui;
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:nubank_clone/constants/app_colors.dart';
+import 'package:nubank_clone/pages/pix/simulated_pix.dart';
+import 'package:share_plus/share_plus.dart';
+
+class PixDemoScreen extends StatefulWidget {
+  const PixDemoScreen({super.key});
+  @override
+  State<PixDemoScreen> createState() => _PixDemoScreenState();
+}
+
+class _PixDemoScreenState extends State<PixDemoScreen> {
+  final _form = GlobalKey<FormState>();
+  final _receiptKey = GlobalKey();
+  final _fields = List.generate(6, (_) => TextEditingController());
+  int _step = 0;
+  SimulatedPix? _receipt;
+  bool _sharing = false;
+
+  @override
+  void dispose() {
+    for (final field in _fields) { field.dispose(); }
+    super.dispose();
+  }
+
+  SimulatedPix _readForm() => SimulatedPix(
+    recipient: _fields[0].text.trim(), pixKey: _fields[1].text.trim(),
+    institution: _fields[2].text.trim(), sender: _fields[3].text.trim(),
+    cents: parsePixAmount(_fields[4].text)!,
+    description: _fields[5].text.trim(), createdAt: DateTime.now(),
+  );
+
+  Future<void> _share(BuildContext buttonContext) async {
+    if (_sharing || _receipt == null) return;
+    setState(() => _sharing = true);
+    ui.Image? image;
+    try {
+      await WidgetsBinding.instance.endOfFrame;
+      if (!mounted || !buttonContext.mounted) return;
+      final boundary = _receiptKey.currentContext!.findRenderObject()
+          as RenderRepaintBoundary;
+      image = await boundary.toImage(pixelRatio: 2);
+      final data = await image.toByteData(format: ui.ImageByteFormat.png);
+      if (data == null || !buttonContext.mounted) return;
+      final box = buttonContext.findRenderObject() as RenderBox;
+      await Share.shareXFiles(
+        [XFile.fromData(data.buffer.asUint8List(), mimeType: 'image/png')],
+        fileNameOverrides: ['comprovante-SIMULACAO.png'],
+        subject: 'Comprovante de simulação — sem valor financeiro',
+        sharePositionOrigin: box.localToGlobal(Offset.zero) & box.size,
+      );
+    } catch (_) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Não foi possível gerar a imagem. Tente novamente.')),
+      );
+    } finally {
+      image?.dispose();
+      if (mounted) setState(() => _sharing = false);
+    }
+  }
+
+  Widget _button(String label, VoidCallback? onPressed) => SizedBox(
+    width: double.infinity,
+    child: ElevatedButton(
+      style: ElevatedButton.styleFrom(
+        backgroundColor: AppColors.primary, foregroundColor: Colors.white,
+        padding: const EdgeInsets.symmetric(vertical: 16),
+      ),
+      onPressed: onPressed, child: Text(label, textAlign: TextAlign.center),
+    ),
+  );
+
+  Widget _entry() => Form(
+    key: _form, autovalidateMode: AutovalidateMode.onUserInteraction,
+    child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      Text('Simular um Pix', style: Theme.of(context).textTheme.headlineMedium),
+      const SizedBox(height: 8),
+      const Text('Informe os dados para uma demonstração. A chave não será '
+          'consultada e nenhum dinheiro será transferido.'),
+      const SizedBox(height: 24),
+      for (var i = 0; i < _fields.length; i++) Padding(
+        padding: const EdgeInsets.only(bottom: 16),
+        child: TextFormField(
+          key: ValueKey('pix-field-$i'), controller: _fields[i],
+          maxLength: i == 5 ? 140 : i == 4 ? 16 : 100,
+          autocorrect: false,
+          keyboardType: i == 4
+              ? const TextInputType.numberWithOptions(decimal: true)
+              : TextInputType.text,
+          decoration: InputDecoration(
+            labelText: const ['Nome de quem receberia', 'Chave Pix',
+              'Instituição (opcional)', 'Seu nome (opcional)', 'Valor (R\$)',
+              'Descrição (opcional)'][i],
+            hintText: i == 4 ? '150,00' : null,
+            counterText: '', border: const OutlineInputBorder(),
+          ),
+          validator: (value) {
+            if (i == 4 && parsePixAmount(value ?? '') == null) {
+              return 'Informe um valor positivo. Ex.: 150,00';
+            }
+            if (i < 2 && (value == null || value.trim().isEmpty)) {
+              return 'Preencha este campo';
+            }
+            return null;
+          },
+        ),
+      ),
+      const Text('Os dados ficam nesta sessão. Compartilhar a imagem é opcional.',
+          style: TextStyle(fontSize: 12, color: AppColors.secondaryText)),
+      const SizedBox(height: 20),
+      _button('Revisar simulação', () {
+        if (!_form.currentState!.validate()) return;
+        FocusScope.of(context).unfocus();
+        setState(() => _step = 1);
+      }),
+    ]),
+  );
+
+  Widget _review() {
+    final pix = _readForm();
+    return Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+      Text('Revisar simulação', style: Theme.of(context).textTheme.headlineMedium),
+      const SizedBox(height: 24),
+      Text(formatPixAmount(pix.cents),
+          style: const TextStyle(fontSize: 32, fontWeight: FontWeight.bold)),
+      const SizedBox(height: 24),
+      ..._details(pix),
+      const Text('Ao continuar, será gerado apenas um comprovante demonstrativo. '
+          'Não haverá débito, transferência ou validação bancária.'),
+      const SizedBox(height: 24),
+      _button('Confirmar simulação', () => setState(() {
+        _receipt = _readForm(); _step = 2;
+      })),
+      TextButton(onPressed: () => setState(() => _step = 0),
+          child: const Text('Editar dados')),
+    ]);
+  }
+
+  Widget _result() => Column(crossAxisAlignment: CrossAxisAlignment.stretch,
+    children: [
+      RepaintBoundary(key: _receiptKey,
+          child: SimulatedPixReceipt(pix: _receipt!)),
+      const SizedBox(height: 20),
+      Builder(builder: (buttonContext) => _button(
+        _sharing ? 'Gerando imagem…' : 'Compartilhar imagem da simulação',
+        _sharing ? null : () => _share(buttonContext),
+      )),
+      TextButton(onPressed: () async {
+        await Clipboard.setData(ClipboardData(text: _receipt!.asText()));
+        if (!mounted) return;
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(content: Text('Texto da simulação copiado')),
+        );
+      }, child: const Text('Copiar texto da simulação')),
+      TextButton(onPressed: () => setState(() { _receipt = null; _step = 0; }),
+          child: const Text('Nova simulação')),
+    ],
+  );
+
+  @override
+  Widget build(BuildContext context) => SizedBox(
+    height: MediaQuery.sizeOf(context).height * .94,
+    child: Scaffold(
+      backgroundColor: Colors.white,
+      appBar: AppBar(
+        backgroundColor: Colors.white, foregroundColor: AppColors.text,
+        elevation: 0, title: const Text('Pix • demonstração'),
+        leading: IconButton(
+          tooltip: _step == 1 ? 'Voltar aos dados' : 'Fechar',
+          icon: Icon(_step == 1 ? Icons.arrow_back : Icons.close),
+          onPressed: () {
+            if (_step == 1) { setState(() => _step = 0); }
+            else { Navigator.of(context).pop(); }
+          },
+        ),
+      ),
+      body: SafeArea(top: false, child: Column(children: [
+        const SimulationNotice(),
+        Expanded(child: SingleChildScrollView(
+          key: ValueKey(_step), padding: const EdgeInsets.all(20),
+          child: _step == 0 ? _entry() : _step == 1 ? _review() : _result(),
+        )),
+      ])),
+    ),
+  );
+}
+
+class SimulationNotice extends StatelessWidget {
+  const SimulationNotice({super.key});
+  @override
+  Widget build(BuildContext context) => Container(
+    width: double.infinity, color: const Color(0xffffe0a3),
+    padding: const EdgeInsets.all(12),
+    child: const Text('SIMULAÇÃO — SEM VALOR FINANCEIRO',
+      textAlign: TextAlign.center,
+      style: TextStyle(color: Color(0xff4c2c00),
+          fontWeight: FontWeight.bold, fontSize: 13),
+    ),
+  );
+}
+
+List<Widget> _details(SimulatedPix pix) => pix.details.entries.map((e) => Padding(
+  padding: const EdgeInsets.only(bottom: 16),
+  child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+    Text(e.key, style: const TextStyle(fontSize: 12, color: Color(0xff666666))),
+    const SizedBox(height: 4), Text(e.value, style: const TextStyle(fontSize: 16)),
+  ]),
+)).toList();
+
+class SimulatedPixReceipt extends StatelessWidget {
+  final SimulatedPix pix;
+  const SimulatedPixReceipt({required this.pix, super.key});
+  @override
+  Widget build(BuildContext context) => Material(color: Colors.white,
+    child: Column(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
+      const SimulationNotice(),
+      Padding(padding: const EdgeInsets.all(20),
+        child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
+          const Icon(Icons.science_outlined, size: 40, color: AppColors.primary),
+          const SizedBox(height: 16),
+          const Text('Comprovante de simulação',
+              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold)),
+          const SizedBox(height: 8),
+          const Text('Nenhum pagamento foi realizado.'),
+          const SizedBox(height: 24),
+          Text(formatPixAmount(pix.cents),
+              style: const TextStyle(fontSize: 30, fontWeight: FontWeight.bold)),
+          const Divider(height: 40), ..._details(pix),
+          Text('Gerado em: ${pix.dateLabel}'),
+          const SizedBox(height: 12),
+          Text('Referência demonstrativa: ${pix.reference}',
+              style: const TextStyle(fontSize: 12)),
+          const SizedBox(height: 20),
+          const Text('Documento de demonstração. Não é um comprovante bancário '
+              'e não confirma recebimento, débito ou transferência.',
+              style: TextStyle(fontSize: 12)),
+        ]),
+      ),
+      const SimulationNotice(),
+    ]),
+  );
+}
