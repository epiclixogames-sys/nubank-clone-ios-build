diff --git a/lib/pages/pix/contact_book_screen.dart b/lib/pages/pix/contact_book_screen.dart
new file mode 100644
index 0000000..4eec236
--- /dev/null
+++ b/lib/pages/pix/contact_book_screen.dart
@@ -0,0 +1,159 @@
+import 'package:flutter/material.dart';
+import 'package:nubank_clone/constants/app_colors.dart';
+import 'package:nubank_clone/pages/pix/local_pix_contacts.dart';
+
+class ContactBookScreen extends StatefulWidget {
+  final List<LocalPixContact> contacts;
+  final LocalContactStorage storage;
+  const ContactBookScreen({required this.contacts, required this.storage, super.key});
+  @override
+  State<ContactBookScreen> createState() => _ContactBookScreenState();
+}
+
+class _ContactBookScreenState extends State<ContactBookScreen> {
+  late List<LocalPixContact> _contacts;
+  bool _saving = false;
+  @override
+  void initState() { super.initState(); _contacts = List.of(widget.contacts); }
+
+  Future<void> _persist(List<LocalPixContact> next) async {
+    setState(() => _saving = true);
+    try {
+      await widget.storage.save(next);
+      if (mounted) setState(() => _contacts = next);
+    } catch (_) {
+      if (mounted) ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('Não foi possível salvar os contatos. Tente novamente.')),
+      );
+    } finally { if (mounted) setState(() => _saving = false); }
+  }
+
+  Future<void> _edit([LocalPixContact? contact]) async {
+    final result = await showDialog<LocalPixContact>(context: context,
+      builder: (_) => _ContactEditor(contact: contact, contacts: _contacts));
+    if (result == null || !mounted) return;
+    await _persist([..._contacts.where((c) => c.id != result.id), result]
+      ..sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase())));
+  }
+
+  Future<void> _remove(LocalPixContact contact) async {
+    final remove = await showDialog<bool>(context: context, builder: (dialogContext) =>
+      AlertDialog(title: const Text('Excluir contato?'),
+        content: Text('Remover ${contact.name} deste aplicativo?'),
+        actions: [TextButton(onPressed: () => Navigator.pop(dialogContext, false),
+            child: const Text('Cancelar')),
+          TextButton(onPressed: () => Navigator.pop(dialogContext, true),
+            child: const Text('Excluir'))]));
+    if (remove == true && mounted) {
+      await _persist(_contacts.where((c) => c.id != contact.id).toList());
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    appBar: AppBar(title: const Text('Meus contatos'), backgroundColor: Colors.white,
+        foregroundColor: Colors.black, elevation: 0),
+    backgroundColor: Colors.white,
+    body: Column(children: [
+      const Padding(padding: EdgeInsets.all(20), child: Text(
+        'Cadastre somente dados próprios ou autorizados. A pesquisa usa apenas '
+        'estes contatos salvos no aplicativo; não consulta bancos ou o Pix.',
+        style: TextStyle(color: Color(0xff666666), fontSize: 13))),
+      if (_saving) const LinearProgressIndicator(),
+      Expanded(child: _contacts.isEmpty
+        ? const Center(child: Text('Nenhum contato cadastrado.'))
+        : ListView.builder(itemCount: _contacts.length, itemBuilder: (context, index) {
+          final contact = _contacts[index];
+          return ListTile(
+            leading: CircleAvatar(backgroundColor: const Color(0xffeeeeee),
+              child: Text(contact.name.substring(0, 1).toUpperCase(),
+                  style: const TextStyle(color: Colors.black))),
+            title: Text(contact.name), subtitle: Text(contact.subtitle),
+            onTap: _saving ? null : () => _edit(contact),
+            trailing: IconButton(tooltip: 'Excluir ${contact.name}',
+              icon: const Icon(Icons.delete_outline),
+              onPressed: _saving ? null : () => _remove(contact)),
+          );
+        })),
+    ]),
+    floatingActionButton: FloatingActionButton.extended(
+      backgroundColor: AppColors.primary, foregroundColor: Colors.white,
+      onPressed: _saving ? null : () => _edit(),
+      icon: const Icon(Icons.person_add_outlined), label: const Text('Novo contato')),
+  );
+}
+
+class _ContactEditor extends StatefulWidget {
+  final LocalPixContact? contact;
+  final List<LocalPixContact> contacts;
+  const _ContactEditor({this.contact, required this.contacts});
+  @override
+  State<_ContactEditor> createState() => _ContactEditorState();
+}
+
+class _ContactEditorState extends State<_ContactEditor> {
+  final _form = GlobalKey<FormState>();
+  late List<TextEditingController> _fields;
+  String? _error;
+  @override
+  void initState() {
+    super.initState(); final c = widget.contact;
+    _fields = [c?.name ?? '', c?.institution ?? '', c?.cpf ?? '',
+      c?.phone ?? '', c?.email ?? ''].map((s) => TextEditingController(text: s)).toList();
+  }
+  @override
+  void dispose() { for (final c in _fields) { c.dispose(); } super.dispose(); }
+
+  void _save() {
+    if (!_form.currentState!.validate()) return;
+    final contact = LocalPixContact(
+      id: widget.contact?.id ?? DateTime.now().microsecondsSinceEpoch.toString(),
+      name: _fields[0].text.trim(), institution: _fields[1].text.trim(),
+      cpf: _fields[2].text.trim(), phone: _fields[3].text.trim(),
+      email: _fields[4].text.trim().toLowerCase(),
+    );
+    if (contact.keys.isEmpty) {
+      setState(() => _error = 'Informe pelo menos CPF, telefone ou e-mail.'); return;
+    }
+    if (hasConflictingKeys(contact, widget.contacts)) {
+      setState(() => _error = 'Uma dessas chaves já pertence a outro contato.'); return;
+    }
+    Navigator.pop(context, contact);
+  }
+
+  @override
+  Widget build(BuildContext context) => AlertDialog(
+    title: Text(widget.contact == null ? 'Novo contato' : 'Editar contato'),
+    scrollable: true,
+    content: Form(key: _form, child: Column(mainAxisSize: MainAxisSize.min, children: [
+      for (var i = 0; i < _fields.length; i++) Padding(
+        padding: const EdgeInsets.only(bottom: 12),
+        child: TextFormField(key: ValueKey('contact-field-$i'), controller: _fields[i],
+          maxLength: 100, autocorrect: false,
+          keyboardType: i == 4 ? TextInputType.emailAddress
+              : i == 2 || i == 3 ? TextInputType.phone : TextInputType.text,
+          decoration: InputDecoration(labelText: const ['Nome', 'Instituição (opcional)',
+            'CPF (opcional)', 'Telefone (opcional)', 'E-mail (opcional)'][i], counterText: ''),
+          validator: (value) {
+            final text = (value ?? '').trim();
+            if (i == 0 && text.isEmpty) return 'Informe o nome';
+            if (text.isEmpty) return null;
+            if (i == 2 && !RegExp(r'^\d{11}$').hasMatch(normalizeContactKey(text))) {
+              return 'Informe um CPF com 11 dígitos';
+            }
+            if (i == 3 && !RegExp(r'^\d{10,11}$').hasMatch(normalizeContactKey(text))) {
+              return 'Informe telefone com DDD';
+            }
+            if (i == 4 && !RegExp(r'^[^\s@]+@[^\s@]+\.[^\s@]+$').hasMatch(text)) {
+              return 'Informe um e-mail válido';
+            }
+            return null;
+          },
+        ),
+      ),
+      if (_error != null) Text(_error!, style: const TextStyle(color: Colors.red)),
+    ])),
+    actions: [TextButton(onPressed: () => Navigator.pop(context), child: const Text('Cancelar')),
+      TextButton(onPressed: _save, child: const Text('Salvar contato'))],
+  );
+}
diff --git a/lib/pages/pix/local_pix_contacts.dart b/lib/pages/pix/local_pix_contacts.dart
new file mode 100644
index 0000000..bf6ebd7
--- /dev/null
+++ b/lib/pages/pix/local_pix_contacts.dart
@@ -0,0 +1,65 @@
+import 'dart:convert';
+import 'package:shared_preferences/shared_preferences.dart';
+
+String normalizeContactKey(String input) {
+  final text = input.trim().toLowerCase();
+  if (text.contains('@')) return text;
+  if (!RegExp(r'^[\d\s()+.\-]+$').hasMatch(text)) return text;
+  var digits = text.replaceAll(RegExp(r'\D'), '');
+  if (digits.length == 13 && digits.startsWith('55')) {
+    digits = digits.substring(2);
+  }
+  return digits;
+}
+
+class LocalPixContact {
+  final String id, name, institution, cpf, phone, email;
+  const LocalPixContact({required this.id, required this.name,
+    this.institution = '', this.cpf = '', this.phone = '', this.email = ''});
+
+  Set<String> get keys => [cpf, phone, email]
+      .where((key) => key.trim().isNotEmpty)
+      .map(normalizeContactKey).toSet();
+  String get subtitle => email.isNotEmpty ? email : phone.isNotEmpty ? phone : cpf;
+  Map<String, String> toJson() => {'id': id, 'name': name,
+    'institution': institution, 'cpf': cpf, 'phone': phone, 'email': email};
+  factory LocalPixContact.fromJson(Map<String, dynamic> json) => LocalPixContact(
+    id: json['id'] as String, name: json['name'] as String,
+    institution: json['institution'] as String? ?? '',
+    cpf: json['cpf'] as String? ?? '', phone: json['phone'] as String? ?? '',
+    email: json['email'] as String? ?? '',
+  );
+}
+
+LocalPixContact? findLocalContact(List<LocalPixContact> contacts, String key) {
+  final normalized = normalizeContactKey(key);
+  if (normalized.isEmpty) return null;
+  final matches = contacts.where((contact) => contact.keys.contains(normalized));
+  return matches.length == 1 ? matches.single : null;
+}
+
+bool hasConflictingKeys(LocalPixContact candidate, List<LocalPixContact> contacts) =>
+    contacts.any((other) => other.id != candidate.id &&
+        other.keys.intersection(candidate.keys).isNotEmpty);
+
+abstract class LocalContactStorage {
+  Future<List<LocalPixContact>> load();
+  Future<void> save(List<LocalPixContact> contacts);
+}
+
+class PreferencesContactStorage implements LocalContactStorage {
+  final SharedPreferencesAsync _preferences = SharedPreferencesAsync();
+  static const _key = 'pix_academic_contacts_v1';
+  @override
+  Future<List<LocalPixContact>> load() async {
+    final data = await _preferences.getString(_key);
+    if (data == null) return [];
+    final list = jsonDecode(data) as List;
+    return list.map((item) => LocalPixContact.fromJson(
+        Map<String, dynamic>.from(item as Map))).toList();
+  }
+  @override
+  Future<void> save(List<LocalPixContact> contacts) => _preferences.setString(
+    _key, jsonEncode(contacts.map((contact) => contact.toJson()).toList()),
+  );
+}
