+import 'dart:convert';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nubank_clone/pages/pix/local_pix_contacts.dart';
+import 'package:nubank_clone/pages/pix/pix_screen.dart';
+import 'contact_test_storage.dart';
+
+const contact = LocalPixContact(id: 'one', name: 'Contato autorizado',
+    institution: 'Instituição cadastrada', cpf: '123.456.789-00',
+    phone: '(11) 91234-5678', email: 'contato@example.com');
+
+void main() {
+  test('lookup accepts formatting and never returns an unknown identity', () {
+    expect(findLocalContact([contact], '12345678900')?.id, 'one');
+    expect(findLocalContact([contact], '+55 (11) 91234-5678')?.id, 'one');
+    expect(findLocalContact([contact], ' CONTATO@EXAMPLE.COM ')?.id, 'one');
+    expect(findLocalContact([contact], 'outro@example.com'), isNull);
+    expect(findLocalContact([contact], ''), isNull);
+    expect(findLocalContact([contact], 'contato'), isNull);
+  });
+  test('contacts survive JSON roundtrip and conflicting keys are rejected', () {
+    final restored = LocalPixContact.fromJson(jsonDecode(jsonEncode(contact.toJson())));
+    expect(restored.keys, contact.keys);
+    expect(restored.name, contact.name);
+    const duplicate = LocalPixContact(id: 'two', name: 'Outro',
+        email: 'CONTATO@example.com');
+    expect(hasConflictingKeys(duplicate, [contact]), isTrue);
+    expect(hasConflictingKeys(contact, [contact]), isFalse);
+    expect(findLocalContact([contact, duplicate], contact.email), isNull);
+  });
+  testWidgets('registered key fills details; changing key clears stale data', (tester) async {
+    await tester.pumpWidget(MaterialApp(home: PixScreen(
+        contactStorage: MemoryContactStorage([contact]))));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Transferir'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byKey(const ValueKey('pix-field-1')), 'CONTATO@example.com');
+    await tester.pumpAndSettle();
+    TextFormField field(int i) => tester.widget<TextFormField>(
+        find.byKey(ValueKey('pix-field-$i')));
+    expect(field(0).controller!.text, contact.name);
+    expect(field(2).controller!.text, contact.institution);
+    await tester.enterText(find.byKey(const ValueKey('pix-field-1')), 'outro@example.com');
+    await tester.pumpAndSettle();
+    expect(field(0).controller!.text, isEmpty);
+    expect(field(2).controller!.text, isEmpty);
+  });
+  testWidgets('contact editor saves into the local repository', (tester) async {
+    final storage = MemoryContactStorage();
+    await tester.pumpWidget(MaterialApp(home: PixScreen(contactStorage: storage)));
+    await tester.pumpAndSettle();
+    await tester.ensureVisible(find.text('Meus contatos'));
+    await tester.tap(find.text('Meus contatos'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Novo contato'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byKey(const ValueKey('contact-field-0')), 'Contato autorizado');
+    await tester.enterText(find.byKey(const ValueKey('contact-field-4')), 'contato@example.com');
+    await tester.ensureVisible(find.text('Salvar contato'));
+    await tester.tap(find.text('Salvar contato'));
+    await tester.pumpAndSettle();
+    expect(storage.contacts.single.email, 'contato@example.com');
+    await tester.pageBack();
+    await tester.pumpAndSettle();
+    await tester.ensureVisible(find.text('Transferir'));
+    await tester.tap(find.text('Transferir'));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byKey(const ValueKey('pix-field-1')), 'contato@example.com');
+    await tester.pumpAndSettle();
+    expect(tester.widget<TextFormField>(find.byKey(const ValueKey('pix-field-0')))
+        .controller!.text, 'Contato autorizado');
+  });
+}
